# Copia este archivo a .env.local y ajusta los valores.

# Postgres. En local: el contenedor de docker-compose.
# En producción: la URL *con pooler* de Neon o Supabase (modo transacción), nunca la directa.
DATABASE_URL=postgres://twenty:twenty@localhost:5433/twenty
# Conexiones por instancia (serverless: pocas; el pooler multiplexa).
DATABASE_POOL_MAX=5

# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de las imágenes. En local se sirve public/media (symlink a assets/images).
# En producción: el dominio del bucket R2/S3 con CDN, p. ej. https://media.twentymoda.com
NEXT_PUBLIC_MEDIA_URL=/media
# "cloudflare" para redimensionar con /cdn-cgi/image en el CDN; vacío para servir el original.
NEXT_PUBLIC_MEDIA_TRANSFORM=

# Tests de integración (pnpm test:int). Nunca la misma BD de desarrollo.
TEST_DATABASE_URL=postgres://twenty:twenty@localhost:5433/twenty_test

# Cloudflare R2 (fotos subidas desde el admin). Sin estas variables, en local se guardan en assets/images.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Culqi (tarjeta y Yape). Generar llaves NUEVAS en CulqiPanel → Desarrollo → API Keys (las del sitio anterior
# se consideran expuestas). En desarrollo usar las de prueba: pk_test_… / sk_test_…
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Secreto del webhook: https://<dominio>/api/webhooks/culqi?key=<este valor>
CULQI_WEBHOOK_SECRET=

# Vercel Cron: anula pedidos con tarjeta sin pagar (vercel.json). Vercel manda "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Emails (Resend): pedidos (cliente y equipo), Libro de Reclamaciones y avisos de contacto.
# Sin estas variables no se envía nada (solo se avisa en consola). EMAIL_FROM debe ser de un dominio verificado en Resend,
# p. ej. "TWENTY <pedidos@twentymoda.com>" (al verificar el dominio NO tocar los registros MX del correo actual).
# Para probar en local sin dominio: EMAIL_FROM="TWENTY <onboarding@resend.dev>" (solo llega al dueño de la cuenta de Resend).
RESEND_API_KEY=
EMAIL_FROM=

# Cuentas de cliente: entrar con Google usando Firebase Authentication (proyecto "twenty-moda" de la cuenta de TWENTY).
# Es la configuración web de la app (pública por diseño). Sale con: npx firebase-tools apps:sdkconfig WEB --project twenty-moda
# Sin estas variables, /ingresar muestra que el ingreso no está disponible (comprar sin cuenta sigue funcionando).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shalom (envíos a provincia) vía Shalom API Perú (api.shalom-api.lat, servicio de terceros; plan con cuota mensual).
# Con la llave, el checkout ofrece la lista real de agencias y la página del pedido muestra el seguimiento de la guía.
# Sin ella, la agencia se escribe como texto.
SHALOM_API_KEY=

# Olva Courier vía Olva API (api.olva-api.lat, servicio de terceros, no de Olva; plan Start: 5.000 consultas al mes).
# Igual que Shalom: lista real de agencias en el checkout y seguimiento de la guía (N° de tracking + año de emisión).
OLVA_API_KEY=
